# ── App ──────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-use-a-very-long-random-string-here
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=asa
POSTGRES_PASSWORD=asa_secure_password
POSTGRES_DB=asa_platform
DATABASE_URL=postgresql+psycopg2://asa:asa_secure_password@localhost:5432/asa_platform

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI APIs ──────────────────────────────────────────────────────────────
# Perplexity Sonar (research agent)
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek (writing + tone agent)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Institutional Research APIs (v2.5) ───────────────────────────────────────
# Elsevier Scopus (institutional agent)
SCOPUS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Springer Nature API
SPRINGER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IEEE Xplore API
IEEE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Plagiarism ────────────────────────────────────────────────────────────
COPYLEAKS_EMAIL=your@email.com
COPYLEAKS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PayPal ────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password

# ── n8n ───────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=n8npassword
N8N_HOST=localhost
N8N_API_KEY=

# ── File storage ─────────────────────────────────────────────────────────
OUTPUT_DIR=/tmp/asa-outputs
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=asa-documents
